---
import "../styles/global.css";
import { resolveSiteConfig } from "@repo/site-config";

interface Props {
  title: string;
}

const { title } = Astro.props;
const site = resolveSiteConfig(import.meta.env.PUBLIC_SITE_URL);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {site.name}</title>
  </head>
  <body>
    {
      Astro.locals.accessSkipped && (
        <p class="m-0 bg-[#fdf6e8] px-4 py-2 text-center text-xs text-muted-foreground">
          ローカル開発モードです。Access のチームドメインと AUD が空のため、JWT 検証を省略しています。本番ビルドでは未設定だと 403 になります。
        </p>
      )
    }
    <div class="flex min-h-screen flex-col md:flex-row">
      <aside class="flex w-full shrink-0 flex-col gap-1 border-b border-border bg-background px-3 py-4 md:w-60 md:border-r md:border-b-0">
        <div class="px-2.5 pt-1.5 pb-3.5 text-[15px] font-bold">
          {site.name}
          <small class="block text-xs font-normal text-muted-foreground">管理画面（サンプル）</small>
        </div>
        <a class="flex items-center justify-between rounded-md bg-muted px-2.5 py-2 font-semibold no-underline" href="/contacts/">
          問い合わせ
          <slot name="badge" />
        </a>
      </aside>
      <div class="min-w-0 flex-1 px-4 py-5 md:px-8 md:py-7">
        <slot />
      </div>
    </div>
  </body>
</html>
