---
import { formatJst, isContactStatus, labelForCategory, labelForStatus } from "@repo/contact-form";
import { ContactEditor } from "../../components/ContactEditor";
import { badgeVariants, statusVariant } from "../../components/ui/badge";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { apiRequest, type ContactJson, readServerEnv } from "../../server/api";

const env = readServerEnv();
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) {
  return new Response("見つかりません", { status: 404 });
}

let errorMessage = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  if (intent === "delete") {
    const response = await apiRequest(env, `/api/admin/contacts/${id}`, { method: "DELETE" });
    if (response.status === 204) return Astro.redirect("/contacts/?notice=deleted");
    errorMessage = "削除できませんでした。";
  } else if (intent === "update") {
    const status = String(form.get("status") ?? "");
    const adminNote = String(form.get("admin_note") ?? "");
    const response = await apiRequest(env, `/api/admin/contacts/${id}`, {
      method: "PATCH",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        status: isContactStatus(status) ? status : undefined,
        admin_note: adminNote,
      }),
    });
    if (response.ok) return Astro.redirect("/contacts/?notice=saved");
    errorMessage = "保存できませんでした。";
  }
}

const response = await apiRequest(env, `/api/admin/contacts/${id}`);
if (response.status === 404) {
  Astro.response.status = 404;
}
const contact = response.ok ? ((await response.json()) as ContactJson) : undefined;
---

<DashboardLayout title="問い合わせ詳細">
  <p class="mb-3.5"><a class="text-muted-foreground no-underline" href="/contacts/">← 一覧へ戻る</a></p>
  {errorMessage && <p class="mb-3 text-destructive">{errorMessage}</p>}
  {
    !contact && (
      <p>この問い合わせは見つかりません。削除済みか、番号が違う可能性があります。</p>
    )
  }
  {
    contact && (
      <>
        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h1 class="m-0 text-[22px]">
              問い合わせ詳細{" "}
              <span class={badgeVariants({ variant: statusVariant(contact.status) })}>
                {labelForStatus(contact.status)}
              </span>
            </h1>
            <p class="m-0 text-[13px] text-muted-foreground">
              ID: {contact.id} ／ 受信: {formatJst(contact.created_at)}（JST）
            </p>
          </div>
          <a class="inline-flex h-9 items-center rounded-md border border-border px-3.5 no-underline" href={`mailto:${contact.email}`}>
            メールで返信
          </a>
        </div>
        <div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
          <article class="rounded-lg border border-border bg-background">
            <div class="px-5 pt-4 font-semibold">送信内容</div>
            <div class="px-5 pt-3.5 pb-5">
              <dl class="grid grid-cols-[110px_1fr] gap-x-3.5 gap-y-2 text-sm">
                <dt class="text-muted-foreground">名前</dt>
                <dd class="m-0">{contact.name?.trim() ? contact.name : "（名前なし）"}</dd>
                <dt class="text-muted-foreground">メール</dt>
                <dd class="m-0">{contact.email}</dd>
                <dt class="text-muted-foreground">カテゴリ</dt>
                <dd class="m-0">{labelForCategory(contact.category)}</dd>
              </dl>
              <div class="mt-3 whitespace-pre-wrap rounded-md border border-border bg-zinc-50 px-4 py-3.5">
                {contact.message}
              </div>
              <dl class="mt-4 grid grid-cols-[110px_1fr] gap-x-3.5 gap-y-2 text-xs text-muted-foreground">
                <dt>送信元</dt>
                <dd class="m-0">
                  IP ハッシュ: {contact.ip_hash ?? "—"}（生の IP は保存しません。IPv6
                  は同じネットワーク範囲で同じ値になります）
                </dd>
                <dt>ブラウザ</dt>
                <dd class="m-0">{contact.user_agent ?? "—"}</dd>
              </dl>
            </div>
          </article>
          <ContactEditor
            client:load
            status={isContactStatus(contact.status) ? contact.status : "new"}
            adminNote={contact.admin_note ?? ""}
            name={contact.name?.trim() ? contact.name : "（名前なし）"}
            received={formatJst(contact.created_at)}
          />
        </div>
      </>
    )
  }
</DashboardLayout>
