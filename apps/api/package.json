{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply astro-site-dashboard-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply astro-site-dashboard-db --remote",
    "db:seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@repo/contact-form": "workspace:*",
    "@repo/site-config": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.18",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.162.0"
  }
}
